# Copy to .env:  cp .env.example .env
#
# All backend configuration lives here. Use http://localhost for browser URLs.
#
# Local npm:     DATABASE_URL -> localhost:5432, BULLMQ_REDIS_PORT=6379
# Docker Compose (backend/docker-compose.yml) overrides DB/Redis hosts inside the API container.

# Database (local PostgreSQL — use 5433 if you only run Postgres via Docker on the host)
DATABASE_URL=postgresql://payment:payment@localhost:5432/payment?schema=public

# App
PORT=3000
NODE_ENV=development
PROJECT_NAME=PaymentWebhook
APP_BASE_URL=http://localhost:3000

# PayPal API (sandbox)
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=your-sandbox-client-id
PAYPAL_SECRET_KEY=your-sandbox-secret
PAYPAL_WEBHOOK_ID=your-paypal-webhook-id
PAYPAL_CURRENCY=MYR
PAYPAL_SUPPORTED_CURRENCIES=MYR

# Frontend (PayPal return/cancel — match apps/web dev server port)
FRONTEND_BASE_URL=http://localhost:8080

# BullMQ / Redis (local Redis)
BULLMQ_REDIS_HOST=localhost
BULLMQ_REDIS_PORT=6379
BULLMQ_REDIS_PASSWORD=
BULLMQ_EMAIL_QUEUE_NAME=email-queue
BULLMQ_AUDIT_QUEUE_NAME=audit-queue
BULLMQ_NOTIFICATION_QUEUE_NAME=notification-queue
BULLMQ_PREFIX=paymentwebhook-development
BULLMQ_JOB_ATTEMPTS=5
BULLMQ_JOB_BACKOFF_DELAY_MS=1000
BULLMQ_REMOVE_ON_FAIL=1000

# Mock payment: true = simulated webhook only. false = real PayPal popup checkout.
MOCK_PAYMENT_GATEWAY=false
MOCK_WEBHOOK_SECRET=replace-with-long-random-string
MOCK_CAPTURE_DELAY_MS=2500

# Order expiry (PROCESSING -> EXPIRED)
ORDER_PROCESSING_EXPIRE_MS=900000
ORDER_EXPIRE_SWEEP_EVERY_MS=60000

# Inventory (checkout hold)
STOCK_RESERVATION_TTL_MS=900000
STOCK_RESERVATION_SWEEP_EVERY_MS=30000
UNPAID_ORDER_EXPIRE_MS=1800000
UNPAID_ORDER_SWEEP_EVERY_MS=60000

# Reconciliation sweep
RECONCILIATION_EVERY_MS=120000
RECONCILIATION_BATCH_SIZE=50
RECONCILIATION_LOOKBACK_MS=600000

# Docker Compose optional host ports (see docker-compose.yml)
# PORT=3000
# POSTGRES_HOST_PORT=5433
# REDIS_HOST_PORT=6380
# ADMINER_HOST_PORT=8081
