DATABASE_URL="postgresql://payment:payment@localhost:5432/payment"

PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=your-sandbox-client-id
PAYPAL_SECRET_KEY=your-sandbox-secret
PAYPAL_WEBHOOK_ID=your-paypal-webhook-id
PAYPAL_CURRENCY=MYR
PAYPAL_SUPPORTED_CURRENCIES=MYR

# Frontend URL used for PayPal return/cancel redirects
FRONTEND_BASE_URL=http://localhost:8080

# BullMQ Redis connection
BULLMQ_REDIS_HOST=localhost
BULLMQ_REDIS_PORT=6379
BULLMQ_REDIS_PASSWORD=

# Mock PayPal only: simulates gateway → your webhook after a short delay (no PayPal UI)
MOCK_PAYMENT_GATEWAY=true
MOCK_WEBHOOK_SECRET=replace-with-long-random-string
MOCK_CAPTURE_DELAY_MS=2500

# Production-style: order expiry (auto mark PROCESSING -> EXPIRED)
ORDER_PROCESSING_EXPIRE_MS=900000
ORDER_EXPIRE_SWEEP_EVERY_MS=60000

# Base URL this app listens on (mock uses it to POST /webhooks/paypal)
APP_BASE_URL=http://127.0.0.1:3000
