// Domain enums live under backend/src/modules/*/enums/ (not declared here).
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id                String             @id @default(cuid())
  sku               String             @unique
  name              String
  stock             Int // total_stock / physical on-hand
  reservedStock     Int                @default(0)
  version           Int                @default(0)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  ledgerEntries     StockLedgerEntry[]
  stockReservations StockReservation[]
}

model StockLedgerEntry {
  id            String   @id @default(cuid())
  productId     String
  product       Product  @relation(fields: [productId], references: [id])
  sku           String
  orderId       String?
  reservationId String?
  quantity      Int
  stockDelta    Int
  reservedDelta Int
  reason        String
  correlationId String?
  createdAt     DateTime @default(now())

  @@index([sku, createdAt])
  @@index([orderId])
}

model OrderLineItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sku       String
  quantity  Int
  unitPrice Decimal @db.Decimal(12, 2)

  @@index([orderId])
}

// Audit trail: update status (CONFIRMED / RELEASED / …); never DELETE rows.
model StockReservation {
  id             String    @id @default(cuid())
  orderId        String
  order          Order     @relation(fields: [orderId], references: [id], onDelete: Restrict)
  productId      String?
  product        Product?  @relation(fields: [productId], references: [id])
  sku            String
  quantity       Int
  status         String    @default("RESERVED")
  reservationKey String    @unique
  expiresAt      DateTime
  reservedAt     DateTime  @default(now())
  confirmedAt    DateTime?
  fulfilledAt    DateTime?
  releasedAt     DateTime?
  expiredAt      DateTime?
  restockedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([orderId, status])
  @@index([status, expiresAt])
  @@index([productId])
}

model Order {
  id                String             @id @default(cuid())
  externalRef       String?
  amount            Decimal            @db.Decimal(12, 2)
  currency          String
  status            String             @default("UNPAID")
  idempotencyKey    String             @unique
  paypalOrderId     String?            @unique
  approvalUrl       String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  lineItems         OrderLineItem[]
  stockReservations StockReservation[]
  webhookEvents     WebhookEvent[]
}

model ProcessedEvent {
  eventId     String   @id
  provider    String
  processedAt DateTime @default(now())
}

model WebhookEvent {
  id          String    @id @default(cuid())
  eventId     String    @unique
  type        String
  payload     Json
  status      String    @default("RECEIVED")
  createdAt   DateTime  @default(now())
  processedAt DateTime?
  orderId     String?
  order       Order?    @relation(fields: [orderId], references: [id])
}
